{
  "tests": [
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "21289119@mail.ru", "password": "wrong"},
      "expectedStatus": 401
    },
    {
      "name": "Login correct",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "21289119@mail.ru", "password": "admin123"},
      "expectedStatus": 200,
      "expectedBody": {"token": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    }
  ]
}
