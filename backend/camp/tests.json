{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Programs list returns 200",
      "method": "GET",
      "path": "/?action=programs",
      "expectedStatus": 200
    },
    {
      "name": "Login without credentials fails",
      "method": "POST",
      "path": "/?action=login",
      "body": {},
      "expectedStatus": 401
    },
    {
      "name": "Me without token unauthorized",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Admin cert template without token unauthorized",
      "method": "GET",
      "path": "/?action=admin-cert-template",
      "expectedStatus": 401
    },
    {
      "name": "Admin certificates without token unauthorized",
      "method": "GET",
      "path": "/?action=admin-certificates",
      "expectedStatus": 401
    }
  ]
}