{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Programs list returns 200",
      "method": "GET",
      "path": "/?action=programs",
      "expectedStatus": 200
    },
    {
      "name": "Login redirects to Dabbl ID",
      "method": "POST",
      "path": "/?action=login",
      "body": {},
      "expectedStatus": 410
    },
    {
      "name": "Me without token unauthorized",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Admin cert template without token unauthorized",
      "method": "GET",
      "path": "/?action=admin-cert-template",
      "expectedStatus": 401
    },
    {
      "name": "Admin certificates without token unauthorized",
      "method": "GET",
      "path": "/?action=admin-certificates",
      "expectedStatus": 401
    },
    {
      "name": "Register redirects to Dabbl ID",
      "method": "POST",
      "path": "/?action=register",
      "body": {"email": "test@example.com", "password": "123456", "full_name": "Иван"},
      "expectedStatus": 410
    },
    {
      "name": "Profile update without token unauthorized",
      "method": "POST",
      "path": "/?action=profile-update",
      "body": {"full_name": "Иван Иванов"},
      "expectedStatus": 401
    }
  ]
}
