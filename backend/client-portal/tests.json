{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Login without credentials",
      "method": "POST",
      "path": "/?action=login",
      "expectedStatus": 400,
      "expectedBody": {"error": "Email и пароль обязательны"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin login-as-client without token",
      "method": "POST",
      "path": "/?action=admin-login-as-client",
      "body": {"id": 1},
      "expectedStatus": 401,
      "expectedBody": {"error": "Нет доступа"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin payment delete without token",
      "method": "POST",
      "path": "/?action=admin-payment-delete",
      "body": {"id": 1},
      "expectedStatus": 401,
      "expectedBody": {"error": "Нет доступа"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin balance charge without token",
      "method": "POST",
      "path": "/?action=admin-balance-charge",
      "body": {"client_id": 1, "amount": 100, "basis": "test"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Нет доступа"},
      "bodyMatcher": "partial"
    }
  ]
}