{
  "tests": [
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "21289119@mail.ru", "password": "definitely-not-the-password"},
      "expectedStatus": 401
    },
    {
      "name": "Me without token",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Userinfo without token",
      "method": "GET",
      "path": "/?action=userinfo",
      "expectedStatus": 401
    },
    {
      "name": "Unknown client info",
      "method": "GET",
      "path": "/?action=client-info&client_id=ghost",
      "expectedStatus": 404
    },
    {
      "name": "Cabinet client info",
      "method": "GET",
      "path": "/?action=client-info&client_id=cabinet",
      "expectedStatus": 200
    },
    {
      "name": "Invite info missing",
      "method": "GET",
      "path": "/?action=invite-info&token=nonexistent",
      "expectedStatus": 404
    }
  ]
}
