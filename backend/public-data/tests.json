{
  "tests": [
    {
      "name": "Получить орг-схему",
      "method": "GET",
      "path": "/?action=org",
      "expectedStatus": 200,
      "expectedBody": {"nodes": "array"},
      "bodyMatcher": "keys_exist"
    },
    {
      "name": "Отправить форму без данных — ошибка",
      "method": "POST",
      "path": "/?action=contact",
      "body": {"name": "", "email": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "Имя и email обязательны"},
      "bodyMatcher": "partial"
    }
    ,{
      "name": "Получить данные директора",
      "method": "GET",
      "path": "/?action=director",
      "expectedStatus": 200,
      "expectedBody": {"info": {}, "bio": [], "photos": []},
      "bodyMatcher": "keys_exist"
    }
  ]
}